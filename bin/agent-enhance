#!/usr/bin/env bash
# agent-enhance — Add AI-agent-native structure and protocols to an existing repository
# Mission-critical: additive, idempotent, non-destructive, auditable, reviewable
# Version: 0.5.0
# Source: https://github.com/makeroftools/agent-enhanced-repo-template

set -euo pipefail

VERSION="0.5.0"

DRY_RUN=false
SYNTHESIZE=false
FORCE_PROTOCOLS=false
INCLUDE_MULTI_AGENT=false
INCLUDE_SAMPLE_SKILL=false
ALLOW_DIRTY=false
TARGET_DIR="."
MARKER_BEGIN="<!-- AGENT-ENHANCE:BEGIN -->"
MARKER_END="<!-- AGENT-ENHANCE:END -->"

die()  { echo "error: $*" >&2; exit 1; }
info() { echo "→ $*"; }
warn() { echo "warning: $*" >&2; }

is_git_repo() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

detect_language() {
  local dir="$1"
  if [[ -f "$dir/pyproject.toml" || -f "$dir/setup.py" || -f "$dir/requirements.txt" ]]; then
    echo "Python"
  elif [[ -f "$dir/package.json" ]]; then
    echo "TypeScript / Node"
  elif [[ -f "$dir/Cargo.toml" ]]; then
    echo "Rust"
  elif [[ -f "$dir/go.mod" ]]; then
    echo "Go"
  else
    echo "Other"
  fi
}

write_file() {
  local path="$1"
  local content="$2"
  if [[ -f "$path" ]]; then
    if [[ "$(cat "$path")" == "$content" ]]; then
      return 0
    fi
  fi
  if $DRY_RUN; then
    info "[dry-run] would write: $path"
    return 0
  fi
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$content" > "$path"
  info "wrote: $path"
}

append_if_missing() {
  local path="$1"
  local block="$2"
  if [[ -f "$path" ]] && grep -qF "$MARKER_BEGIN" "$path" 2>/dev/null; then
    return 0
  fi
  if $DRY_RUN; then
    info "[dry-run] would inject protocols into: $path"
    return 0
  fi
  {
    printf '\n%s\n' "$MARKER_BEGIN"
    printf '%s\n' "$block"
    printf '%s\n' "$MARKER_END"
  } >> "$path"
  info "injected protocols into: $path"
}

usage() {
  cat <<'USAGE'
agent-enhance v0.5.0
Add AI-agent-native structure and mandatory protocols to an existing repository.

Usage: agent-enhance [OPTIONS] [TARGET_DIR]

Options:
  -n, --dry-run              Show what would be done without writing files
  --synthesize               Synthesize-and-apply: rewrite the live AGENTS.md to a lean,
                             protocol-compliant version that elevates Canon / Skills /
                             Current material. Uses broader safe discovery across docs/,
                             .github/, .cursor/, .agents/, adr/, decisions/, policies/,
                             runbooks/ and similar. Sources are classified into tiers;
                             historical and archive material is inventoried and referenced,
                             never bulk-inlined. All discovered knowledge is preserved under
                             .agents/references/ (complete inventory + full sources). Run
                             with --dry-run first to preview.
  --allow-dirty              Permit operation on a dirty Git working tree
                             (default is to refuse)
  --multi-agent              Include role charters (coordinator, implementer, reviewer)
  --sample-skill             Include a sample Skill under .agents/skills/
  -h, --help                 Show this help
  --version                  Show version

Design principles (mission-critical):
  - Additive and non-destructive by default
  - Idempotent — safe to re-run
  - Explicit protocols are mandatory
  - The enhancement itself is recorded as a decision
  - Existing content is preserved; nothing discovered may become invisible
  - In --synthesize mode, the live AGENTS.md is rewritten lean; everything discovered
    is preserved under .agents/references/ and no source file is deleted
USAGE
}

PROTOCOL_BLOCK=$(cat <<'PROT'
## Session Start Protocol (Mandatory)

On every new session or thread:

1. Read `.agents/memory/current-status.md`.
2. Read the recent entries in `.agents/memory/decisions.md`.
3. If a relevant handoff exists in `.agents/handoffs/`, read the most recent applicable one.
4. Summarize the relevant prior context before beginning substantive work.

## Session End / Handoff Protocol (Mandatory)

When work is incomplete, blocked, or will continue in another session/thread:

1. Write a complete handoff file using the template in `.agents/handoffs/template-handoff.md`.
2. Place it in `.agents/handoffs/` with a clear name (e.g., `YYYY-MM-DD-short-title.md`).
3. Update `.agents/memory/current-status.md` to reflect the handoff.

## Hard Constraints (Agent Continuity)

- All non-trivial architectural or process decisions must be recorded in `.agents/memory/decisions.md`.
- Session continuity relies on the files under `.agents/`. Do not treat chat history as durable state.
- Prefer explicit handoffs over implicit continuity.
PROT
)

# The alignment-related instructions body used both for inline injection (existing
# AGENTS.md) and inside synthesized proposals. Kept identical across both paths.
PROGRESSIVE_DISCLOSURE_BLOCK=$(cat <<'PROG'
## Progressive Disclosure

Root AGENTS.md (this file) contains always-on rules.
Detailed guidance lives in .agents/references/.
Task-specific workflows live in .agents/skills/ (Zed Skills and compatible tools).
Load deeper context only when the task requires it.
PROG
)

DEFINITION_OF_DONE_BLOCK=$(cat <<'DOD'
## Definition of Done

Relevant tests pass.
Lint / type checks are clean (where applicable).
Decisions of substance are recorded in .agents/memory/decisions.md.
If work continues elsewhere, a proper handoff file exists.
current-status.md reflects reality.
DOD
)

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --version) echo "agent-enhance $VERSION"; exit 0 ;;
    -n|--dry-run) DRY_RUN=true; shift ;;
    --synthesize) SYNTHESIZE=true; shift ;;
    --force-protocols) FORCE_PROTOCOLS=true; shift ;;
    --allow-dirty) ALLOW_DIRTY=true; shift ;;
    --multi-agent) INCLUDE_MULTI_AGENT=true; shift ;;
    --sample-skill) INCLUDE_SAMPLE_SKILL=true; shift ;;
    -*) die "unknown option: $1" ;;
    *) TARGET_DIR="$1"; shift ;;
  esac
done

TARGET_DIR="$(cd "$TARGET_DIR" 2>/dev/null && pwd)" || die "cannot access target directory: $TARGET_DIR"
cd "$TARGET_DIR"

info "Target repository: $TARGET_DIR"
$DRY_RUN && info "Mode: DRY-RUN (no files will be written)"
if $SYNTHESIZE; then
  info "Mode: SYNTHESIZE-APPLY (rewrites the live AGENTS.md lean; all discovered knowledge is preserved under .agents/references/)"
fi

LANG=$(detect_language "$TARGET_DIR")
info "Detected language/stack: $LANG"

if is_git_repo "$TARGET_DIR"; then
  info "Git repository detected"
  # --- Git working-tree status gate (v0.4.0) ---
  # Detect staged, unstaged, or untracked (non-ignored) changes. Clean tree proceeds;
  # dirty tree refuses by default unless --allow-dirty is given. This mirrors how
  # `git status --porcelain` behaves: placeholder-free and safe to parse.
  if [[ -z "$(git status --porcelain 2>/dev/null)" ]]; then
    :  # clean tree — proceed; keep output noise-free
  else
    if $ALLOW_DIRTY; then
      warn "SAFETY OVERRIDE: the Git working tree is dirty and you have chosen to proceed with --allow-dirty. Review the changes before committing."
    else
      die "The Git working tree is dirty (staged/unstaged/untracked changes present). Refusing to proceed to keep enhancements reviewable. Commit or stash your changes, or re-run with --allow-dirty to override."
    fi
  fi
else
  warn "Not a git repository — continuing anyway (recommended to run inside a git repo)"
fi

AGENTS_DIR=".agents"
MEMORY_DIR="$AGENTS_DIR/memory"
HANDOFFS_DIR="$AGENTS_DIR/handoffs"
AGENTS_ROLES_DIR="$AGENTS_DIR/agents"
SKILLS_DIR="$AGENTS_DIR/skills"
REFS_DIR="$AGENTS_DIR/references"

if $DRY_RUN; then
  info "[dry-run] would ensure directories under .agents/"
else
  mkdir -p "$MEMORY_DIR" "$HANDOFFS_DIR" "$REFS_DIR"
  info "ensured directories under .agents/"
fi

# ----- decisions.md -----
if [[ ! -f "$MEMORY_DIR/decisions.md" ]]; then
  TODAY=$(date +%Y-%m-%d)
  CONTENT=$(cat <<'DECISIONS'
# Decisions Log

This is an append-only drop-box for architectural, process, and significant technical decisions.
Agents and humans must record decisions here so that future sessions have durable, auditable context.

## Entry Format

```markdown
### YYYY-MM-DD — Short Title

- **Decision**: One or two clear sentences.
- **Rationale**: Why this choice was made.
- **Alternatives considered**: Brief list (optional).
- **Consequences / follow-ups**: What this implies.
- **Related files / PRs**: Links or paths.
- **Recorded by**: Human or agent role/name.
```

DATE_PLACEHOLDER — Agent Enhancement Applied

Decision: Applied the agent-enhance structure and mandatory continuity protocols to this repository.
Rationale: Enable durable session continuity, explicit handoffs, and auditable decision logging for AI agents and humans.
Consequences / follow-ups: All future agent sessions must follow the Session Start and Handoff protocols. Keep decisions.md and current-status.md current.
Related files / PRs: .agents/, AGENTS.md
Recorded by: agent-enhance vVERSION_PLACEHOLDER
DECISIONS
)
  CONTENT="${CONTENT//DATE_PLACEHOLDER/$TODAY}"
  CONTENT="${CONTENT//VERSION_PLACEHOLDER/$VERSION}"
  write_file "$MEMORY_DIR/decisions.md" "$CONTENT"
else
  info "exists (left untouched): $MEMORY_DIR/decisions.md"
fi

# ----- current-status.md -----
if [[ ! -f "$MEMORY_DIR/current-status.md" ]]; then
  write_file "$MEMORY_DIR/current-status.md" "$(cat <<'EOF'
Current Status
This file is the high-level, living summary of the repository’s agent-relevant state.
Update it whenever the overall picture changes significantly.
Project Goal
(Describe the primary purpose of this repository.)
Current Focus

Agent-enhancement structure has been applied.
Core protocols (Session Start, Handoff, decisions log) are now active.

Active Work / Open Threads

None recorded yet. Update this section when work begins.

Known Blockers / Risks

None recorded.

Last Updated

By: agent-enhance
Note: Replace this section on first real update.
EOF
)"
else
  info "exists (left untouched): $MEMORY_DIR/current-status.md"
fi

# ----- handoff template -----
if [[ ! -f "$HANDOFFS_DIR/template-handoff.md" ]]; then
  write_file "$HANDOFFS_DIR/template-handoff.md" "$(cat <<'EOF'
Handoff — <short-title> — <YYYY-MM-DD or thread-id>
Goal
What the previous session was trying to achieve.
Current State

Completed:
...

In progress:
...

Blocked / open questions:
...


Key Decisions Made
Reference or quote relevant entries from .agents/memory/decisions.md.
Files / Areas Touched

List of primary files, packages, or worktrees involved.

Exact Next Actions for the Receiving Session

...
...
...

Context the New Agent Must Load

Always: .agents/memory/current-status.md and recent .agents/memory/decisions.md
Relevant skills: (list if any)
Relevant references: (list if any)
Role charter (if multi-agent): (path)

Additional Notes
Any other information the receiving agent needs to continue safely and correctly.
EOF
)"
else
  info "exists (left untouched): $HANDOFFS_DIR/template-handoff.md"
fi

# ----- references -----
if [[ ! -f "$REFS_DIR/architecture.md" ]]; then
  write_file "$REFS_DIR/architecture.md" "$(cat <<'EOF'
Architecture Notes
High-level Structure
(Expand this file with the real system architecture, key components, data flows, and boundaries.)
Key Directories

Source code: (document primary locations)
Tests: (document)
Agent infrastructure: .agents/ (skills, memory, handoffs, role charters, references)

Design Principles Relevant to Agents

Prefer small, reviewable changes.
Keep durable state in version-controlled files under .agents/.
Use progressive disclosure: load detailed references only when needed.
EOF
)"
fi

if [[ ! -f "$REFS_DIR/conventions.md" ]]; then
  write_file "$REFS_DIR/conventions.md" "$(cat <<'EOF'
Conventions
Code Style
Follow the project’s established tooling and existing patterns.
Git & Collaboration

Prefer small, focused commits and pull requests.
Write clear commit messages that explain the “why”.
Record non-trivial decisions in .agents/memory/decisions.md.

Agent-specific Conventions

Always execute the Session Start protocol.
Never treat chat history as the source of truth for project state.
Prefer explicit handoffs over implicit continuity.
EOF
)"
fi

# ----- multi-agent roles -----
if $INCLUDE_MULTI_AGENT; then
  $DRY_RUN || mkdir -p "$AGENTS_ROLES_DIR"
  if [[ ! -f "$AGENTS_ROLES_DIR/coordinator.md" ]]; then
    write_file "$AGENTS_ROLES_DIR/coordinator.md" "$(cat <<'EOF'
Role: Coordinator
Purpose
Own overall progress, prioritization, and coordination across agents or sequential sessions.
Responsibilities

Maintain a clear view of current status and open work.
Decide when to hand off to specialist roles.
Ensure decisions are recorded and current-status.md stays truthful.

Must Never

Perform large-scale implementation that belongs to the Implementer role without justification.
Leave incomplete handoffs.
EOF
)"
  fi

  if [[ ! -f "$AGENTS_ROLES_DIR/implementer.md" ]]; then
    write_file "$AGENTS_ROLES_DIR/implementer.md" "$(cat <<'EOF'
Role: Implementer
Purpose
Execute concrete changes according to an agreed plan or handoff. Prefer small, reviewable increments.
Responsibilities

Implement the requested changes following project conventions.
Write or update tests as appropriate.
Record any non-trivial decisions made during implementation.

Must Never

Expand scope significantly without updating the handoff.
Leave the repository in a broken or untested state.
Ignore the Session Start protocol.
EOF
)"
  fi

  if [[ ! -f "$AGENTS_ROLES_DIR/reviewer.md" ]]; then
    write_file "$AGENTS_ROLES_DIR/reviewer.md" "$(cat <<'EOF'
Role: Reviewer
Purpose
Examine proposed changes for correctness, adherence to conventions, security, and completeness.
Responsibilities

Review diffs against project standards and the stated goal.
Check that tests are adequate and decisions of substance were recorded.
Surface risks or deviations from established patterns.

Must Never

Directly implement large changes that belong to the Implementer role.
Approve work that violates hard constraints in AGENTS.md.
EOF
)"
  fi
fi

# ----- sample skill -----
if $INCLUDE_SAMPLE_SKILL; then
  SKILL_PATH="$SKILLS_DIR/example-skill/SKILL.md"
  $DRY_RUN || mkdir -p "$(dirname "$SKILL_PATH")"
  if [[ ! -f "$SKILL_PATH" ]]; then
    write_file "$SKILL_PATH" "$(cat <<'EOF'
name: example-skill
description: "Illustrative skill demonstrating the expected format. Replace with real project workflows."
Example Skill
This is a placeholder Skill. Replace its content with a real, reusable workflow for this repository.
When to use

Use this skill when the task matches the description above.

Instructions

Confirm the goal and any constraints from AGENTS.md and the current handoff/status.
Perform the core steps of the workflow.
Record any decisions of substance in .agents/memory/decisions.md.
Update status or write a handoff if the work is incomplete.
EOF
)"
  fi
fi

# ============================================================================
# Discovery helpers for --synthesize (broader, safe, bounded)
# ============================================================================

# Files whose names or paths match a knowledge-bearing pattern. Case-insensitive.
# Matched against the basename and the full path so we pick up e.g. docs/architecture.md.
DISCOVERY_PATTERNS=(
  "agent" "claude" "cursor" "rule" "instruction" "convention"
  "guideline" "standard" "playbook" "runbook" "decision" "adr"
  "architecture" "sop" "policy" "prompt"
)

# Directories of interest: their contents are prioritised regardless of name.
DISCOVERY_DIRS=( "docs" ".github" ".cursor" ".agents" "adr" "decisions" "policies" "runbooks" )

# Extensions considered candidate documents.
DISCOVERY_EXTS=( "md" "txt" "rst" "markdown" )

# Hard exclusions: directories never entered, and filename suffixes never matched.
DISCOVERY_SKIP_DIRS=( ".git" "node_modules" "vendor" "dist" "build" "__pycache__" ".venv" "venv" )
DISCOVERY_SKIP_SUFFIXES=( ".lock" ".lockb" ".min.js" ".min.css" ".png" ".jpg" ".jpeg" ".gif" ".svg" ".ico" ".woff" ".woff2" ".ttf" ".pdf" ".zip" ".tar" ".gz" )

# Sources embedded in full when smaller than this threshold; larger ones are referenced.
INLINE_THRESHOLD_BYTES=32768

# ============================================================================
# Source classification tiers for --synthesize (v0.4.0)
# ============================================================================

# Every discovered document is assigned a deterministic tier by path/name rules.
# The mandatory priority order is Canon -> Current/Active -> Skills ->
# Historical Archive -> General Docs -> Other. The first rule whose patterns
# match a path decides its tier. Rules that read `*/<pattern>` match any single
# path segment (e.g. `.agents/canon`, `docs`, `volley`).

TIER_CANON="canon"
TIER_CURRENT="current"
TIER_SKILLS="skills"
TIER_ARCHIVE="archive"
TIER_DOCS="docs"
TIER_OTHER="other"

# High-signal canon filenames (matched on the basename). These are long-lived
# identity / laws / architecture / toolchain documents.
CANON_NAMES=(
  "identity" "system-map" "toolchain" "gestalt" "constitution" "mission"
  "philosophy" "principles" "values" "laws" "architecture"
)

# Pattern groups per tier. Each entry is a glob matched case-insensitively
# against "/$rel" with `*` allowed for any substring.
TIER_CANON_PATTERNS=(
  ".agents/canon/"
)
TIER_CURRENT_PATTERNS=(
  ".agents/memory/current-status.md"
  ".agents/memory/decisions.md"
  "volley/current.md"
  "handoffs/*synthesis-review.md"
  ".agents/current-status.md"
)
TIER_SKILLS_PATTERNS=(
  ".agents/skills/"
)

# Case-insensitive containment test on a slash-padded path. `rel` is
# normalised to lowercase and padded with slashes so segment-boundary patterns
# like "*/volley/archive/*" match a root-level ".agents/..." unambiguously.
path_has() {
  local hay="$1" pat="$2"
  hay="$(printf '%s' "$hay" | tr '[:upper:]' '[:lower:]')"
  pat="$(printf '%s' "$pat" | tr '[:upper:]' '[:lower:]')"
  case "/$hay/" in
    $pat) return 0 ;;
    *)    return 1 ;;
  esac
}

# Classify a relative path into a tier. Deterministic; pure path-based.
classify_tier() {
  local rel="$1" base lower pat n
  base="$(basename "$rel")"
  lower="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"

  # 1. Canon directory or canon filename (highest priority).
  for pat in "${TIER_CANON_PATTERNS[@]}"; do
    path_has "$rel" "*${pat}*" && { echo "$TIER_CANON"; return; }
  done

  # 2. Current/active — must precede the archive rules so active handoffs and
  #    the live volley are not archived.
  for pat in "${TIER_CURRENT_PATTERNS[@]}"; do
    path_has "$rel" "*${pat}*" && { echo "$TIER_CURRENT"; return; }
  done

  # 3. Skills before generic docs so a skill under docs/ is still a skill.
  for pat in "${TIER_SKILLS_PATTERNS[@]}"; do
    path_has "$rel" "*${pat}*" && { echo "$TIER_SKILLS"; return; }
  done

  # 4. Canon filename appearing outside .agents/ (e.g. docs/architecture.md).
  for n in "${CANON_NAMES[@]}"; do
    if [[ "$lower" == "$n" || "$lower" == "$n.md" || "$lower" == "$n.txt" ]]; then
      echo "$TIER_CANON"; return
    fi
  done

  # 5. Historical archive: volley archives, archived handoffs, past-session
  #    memory, session logs. Any depth (.agents/volley/archive/... etc.).
  if path_has "$rel" "*/volley/archive/*"; then
    echo "$TIER_ARCHIVE"; return
  fi
  if path_has "$rel" "*/handoffs/*"; then
    echo "$TIER_ARCHIVE"; return
  fi
  if path_has "$rel" "*/memory/archive/*"; then
    echo "$TIER_ARCHIVE"; return
  fi
  if path_has "$rel" "*/sessions/*"; then
    echo "$TIER_ARCHIVE"; return
  fi
  if path_has "$rel" "*/session-logs/*"; then
    echo "$TIER_ARCHIVE"; return
  fi

  # 6. Basenames that record a specific session / dated handoff / volley.
  if [[ "$lower" =~ ^volley[-_0-9] || "$lower" =~ ^session[-_0-9] || "$lower" =~ ^handoff[-_0-9] ]]; then
    echo "$TIER_ARCHIVE"; return
  fi

  # 7. Docs directories, readme/license.
  for pat in "${DISCOVERY_DIRS[@]}"; do
    path_has "$rel" "*/${pat}/*" && { echo "$TIER_DOCS"; return; }
  done
  case "$lower" in
    readme*|license*) echo "$TIER_DOCS"; return ;;
  esac

  echo "$TIER_OTHER"
}

# Human-readable tier label + disposition guidance (used in proposal).
tier_label() {
  case "$1" in
    "$TIER_CANON")   echo "Canon (long-lived identity, laws, architecture, toolchain)" ;;
    "$TIER_CURRENT") echo "Current / Active (latest status, active handoff, volley)" ;;
    "$TIER_SKILLS")  echo "Skills (reusable agent workflows)" ;;
    "$TIER_ARCHIVE") echo "Historical Archive (session logs, old handoffs, volleys)" ;;
    "$TIER_DOCS")    echo "General Docs (broader documentation, references)" ;;
    *)               echo "Other" ;;
  esac
}

# Whether a tier permits full inlining (bulk) regardless of individual size.
# Canon and Current may inline when under the size threshold; Skills may inline
# (small SKILL.md files); Archive is inventory+reference only; Docs/Other follow
# the size threshold.
tier_allow_inline() {
  case "$1" in
    "$TIER_ARCHIVE") echo "no" ;;
    *)               echo "yes" ;;
  esac
}


# Checks whether a relative path should be treated as a candidate document.
is_candidate() {
  local rel="$1"
  local base ext lower d
  base="$(basename "$rel")"
  # Treat leading-dot filenames (e.g. .cursorrules) as extensionless: the dot is a
  # hidden-file marker, not an extension separator.
  if [[ "$base" == .* ]]; then
    ext=""
  else
    ext="${base##*.}"
    [[ "$ext" == "$base" ]] && ext=""
  fi

  # Reject hard-skipped suffixes (lockfiles, minified assets, binaries, etc.).
  local s
  for s in "${DISCOVERY_SKIP_SUFFIXES[@]}"; do
    case "$base" in
      *"$s") return 1 ;;
    esac
  done

  # A file is a candidate if its extension matches OR it is extensionless,
  # AND (its basename or path matches a knowledge pattern OR it lives in a dir of interest).
  local is_ext=false
  if [[ -n "$ext" ]]; then
    local e
    for e in "${DISCOVERY_EXTS[@]}"; do
      [[ "$ext" == "$e" ]] && { is_ext=true; break; }
    done
  else
    is_ext=true  # extensionless files that match the name patterns count
  fi
  $is_ext || return 1

  # Match basename OR path component against knowledge patterns (case-insensitive).
  lower="$(printf '%s' "$base $rel" | tr '[:upper:]' '[:lower:]')"
  local p d
  for p in "${DISCOVERY_PATTERNS[@]}"; do
    case "$lower" in
      *"$p"*) return 0 ;;
    esac
  done
  for d in "${DISCOVERY_DIRS[@]}"; do
    case "/$rel/" in
      *"/$d/"*) return 0 ;;
    esac
  done
  return 1
}

# Gather candidate documents. Prefers git ls-files inside a git repo; falls back to find.
# Emits one relative path per line, sorted, de-duplicated.
gather_candidates() {
  local list=""
  if is_git_repo "$TARGET_DIR"; then
    while IFS= read -r f; do
      local rel
      rel="$f"
      # Skip anything git considers removed; only consider tracked paths that exist on disk.
      [[ -f "$rel" ]] || continue
      list+="$rel"$'\n'
    done < <(git ls-files)
  else
    while IFS= read -r f; do
      list+="$f"$'\n'
    done < <(find . -type f -print | sed 's#^\./##')
  fi
  # De-duplicate and sort, then filter to candidates and hard exclusions.
  printf '%s' "$list" | sort -u | while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    # Skip any path under a hard-excluded directory.
    local skip=no d
    for d in "${DISCOVERY_SKIP_DIRS[@]}"; do
      case "/$rel/" in
        *"/$d/"*) skip=yes ;;
      esac
    done
    [[ "$skip" == "yes" ]] && continue
    if is_candidate "$rel"; then
      printf '%s\n' "$rel"
    fi
  done
}

# Render a single discovered source into the proposal body, honouring its tier.
#   - Canon / Current / Skills: inlined in full when under the size threshold.
#   - Historical Archive: always inventory + reference (never bulk-inlined),
#     regardless of individual size.
#   - General Docs / Other: inlined when under the threshold, else referenced.
# Extract a short excerpt that is guaranteed to be valid UTF-8. Reads up to
# $1 bytes, collapses newlines to spaces, then runs the bytes through
# `iconv -f UTF-8 -t UTF-8 -c`, which discards any incomplete trailing
# multi-byte sequence so the excerpt never splits a UTF-8 character.
safe_excerpt() {
  local bytes="$1" rel="$2" s
  s=$(head -c "$bytes" "$rel" 2>/dev/null | tr '
' ' ' | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null)
  printf '%s' "$s"
}
# Nothing is ever silently dropped — every file is inventoried and, unless
# inlined, referenced by path with a short excerpt.
archive_excerpt() {
  local rel="$1"
  printf '\n### %s (archived — referenced, %s bytes)\n\n' "$rel" "$(wc -c < "$rel" | tr -d ' ')"
  printf 'Historical/archive material is kept for provenance and reviews, but is NOT\n'
  printf 'bulk-inlined into the proposal. Open it directly for the full content.\n\n'
  printf 'Full content available at: `%s`\n\n' "$rel"
  local excerpt
  excerpt=$(safe_excerpt 300 "$rel")
  printf 'Excerpt: %s\n' "$excerpt"
}

render_source() {
  local rel="$1" bytes tier allow excerpt
  bytes=$(wc -c < "$rel" | tr -d ' ')
  tier="$(classify_tier "$rel")"
  allow="$(tier_allow_inline "$tier")"

  if [[ "$allow" == "no" ]]; then
    archive_excerpt "$rel"
    printf '\n---\n'
    return
  fi

  if (( bytes <= INLINE_THRESHOLD_BYTES )); then
    printf '\n### %s (inlined, %s bytes — tier: %s)\n\n' "$rel" "$bytes" "$tier"
    printf '```markdown\n'
    cat "$rel"
    printf '\n```\n'
  else
    excerpt=$(safe_excerpt 400 "$rel")
    printf '\n### %s (referenced, %s bytes — above inline threshold, tier: %s)\n\n' "$rel" "$bytes" "$tier"
    printf 'Full content available at: `%s` (do not inline; open directly).\n\n' "$rel"
    printf 'Excerpt: %s\n' "$excerpt"
  fi
  printf '\n---\n'
}

# Build the full Discovery Inventory (every considered path + tier + disposition).
build_inventory() {
  local rel bytes disp tier inv=""
  for rel in "${CANDIDATES[@]}"; do
    bytes=$(wc -c < "$rel" | tr -d ' ')
    tier="$(classify_tier "$rel")"
    if [[ "$(tier_allow_inline "$tier")" == "no" ]]; then
      disp="referenced (archive, $bytes B)"
    elif (( bytes <= INLINE_THRESHOLD_BYTES )); then
      disp="inlined ($bytes B)"
    else
      disp="referenced ($bytes B)"
    fi
    inv+="- \`$rel\` — tier: $tier — $disp"$'\n'
  done
  printf '%s' "$inv"
}

# Build the prioritized synthesis: only Canon / Skills / Current material is
# elevated and inlined (or referenced) here. Historical archive and low-signal
# material is NOT included here — it is covered by the Discovery Inventory and
# the reference body.
build_prioritized_synthesis() {
  local rel tier body added=0
  body=$'## Prioritized Synthesis (recommended core)

'
  body+=$'The following material is elevated from the Canon, Skills, and Current/Active
'
  body+=$'tiers. It is the recommended durable, high-signal core for the final AGENTS.md.
'
  body+=$'Historical-archive and low-signal material is intentionally not dumped here;
'
  body+=$'it remains fully inventoried and referenced below for review.
'
  body+=$'
'
  for rel in "${CANDIDATES[@]}"; do
    tier="$(classify_tier "$rel")"
    case "$tier" in
      "$TIER_CANON"|"$TIER_CURRENT"|"$TIER_SKILLS")
        body+="$(render_source "$rel")"$'
'
        added=1 ;;
    esac
  done
  if (( added == 0 )); then
    body+=$'No Canon / Skills / Current material was discovered. The inventory and reference
'
    body+=$'body below document every candidate; review them for the full set.
'
  fi
  printf '%s' "$body"
}

# Build the full reference body: every source, each inlined or referenced per its
# tier (archives are reference-only). This guarantees nothing is dropped while
# keeping bulk history from dominating the document.
build_body() {
  local rel body
  body=$'## Content from Existing / Discovered Sources\n\n'
  body+=$'Every candidate is listed here per its tier. Canon / Current / Skills material is\n'
  body+=$'inlined when small; archives are referenced by path (never bulk-inlined); other\n'
  body+=$'tiers follow the size threshold. Open referenced files to review them in full.\n'
  body+=$'\n'
  for rel in "${CANDIDATES[@]}"; do
    body+="$(render_source "$rel")"$'\n'
  done
  printf '%s' "$body"
}

# Render the lean, always-on live AGENTS.md for the synthesize-and-apply path.
# The live file stays small: mandatory protocols first, then a short architecture
# note, the elevated (Canon / Skills / Current) synthesis, and pointers to the
# durable knowledge under .agents/references/. Historical-archive content is NOT
# bulk-inlined — it lives by reference in synthesis-inventory.md. `count` is the
# number of sources preserved, `synthesis` the elevated-synthesis body.
#
# The elevated body is appended by concatenation (not ${var//old/$new}), because a
# literal `&` inside inlined source content would otherwise be substituted as "the
# matched substring", corrupting the file.
build_live_agents() {
  local count="$1" synthesis="$2"
  local c
  c=$(cat <<'AGENTS'
Agent Instructions
Overview
This repository has been upgraded via agent-enhance --synthesize to a lean, always-on
contract for AI agents and humans. Durable context is preserved by reference under
`.agents/references/`; load only what the task requires (progressive disclosure).

LANG_PLACEHOLDER
MARKER_BEGIN_PLACEHOLDER
PROTOCOL_PLACEHOLDER
MARKER_END_PLACEHOLDER
PROGRESSIVE_PLACEHOLDER
DOD_PLACEHOLDER
Synthesis Notes

Every discovered source was classified by tier (Canon / Current / Skills / Historical
Archive / General Docs / Other) and preserved. None were deleted. The full inventory and
complete per-source content live under:

- Full discovery inventory + every source (full text): .agents/references/synthesis-inventory.md
- Elevated-source notes (canon/current/skills): .agents/references/synthesis-elevated.md
- Decision record: .agents/memory/decisions.md
- Status: .agents/memory/current-status.md
- Handoffs: .agents/handoffs/
- Skills: .agents/skills/

REFERENCE_COUNT_PLACEHOLDER
Further Reading

Architecture notes: .agents/references/architecture.md (when present)
Conventions: .agents/references/conventions.md (when present)
Handoff template: .agents/handoffs/template-handoff.md
Elevated content

AGENTS
)
  c="${c//LANG_PLACEHOLDER/$(printf 'Primary stack (detected): %s.' "$LANG")}"
  c="${c//MARKER_BEGIN_PLACEHOLDER/$MARKER_BEGIN}"
  c="${c//PROTOCOL_PLACEHOLDER/$PROTOCOL_BLOCK}"
  c="${c//MARKER_END_PLACEHOLDER/$MARKER_END}"
  c="${c//PROGRESSIVE_PLACEHOLDER/$PROGRESSIVE_DISCLOSURE_BLOCK}"
  c="${c//DOD_PLACEHOLDER/$DEFINITION_OF_DONE_BLOCK}"
  c="${c//REFERENCE_COUNT_PLACEHOLDER/Reference count: $count source file(s) preserved by reference.}"
  # Append the elevated synthesis by concatenation (see note above).
  printf '%s\n\n%s\n' "$c" "$synthesis"
}

# ============================================================================
# --synthesize mode: synthesize-and-apply
# ============================================================================
if $SYNTHESIZE; then
  TODAY=$(date +%Y-%m-%d)
  INVENTORY_FILE="$REFS_DIR/synthesis-inventory.md"

  # Broader, git-aware discovery. Gather a de-duplicated candidate list.
  info "Discovering candidate documents (git-aware, bounded)"
  CANDIDATES=()
  while IFS= read -r rel; do
    rel="${rel#./}"
    [[ -n "$rel" ]] || continue
    CANDIDATES+=( "$rel" )
  done < <(gather_candidates)

  COUNT="${#CANDIDATES[@]}"
  if (( COUNT == 0 )); then
    info "No candidate documents discovered — nothing to synthesize."
  else
    info "Discovered $COUNT candidate document(s)."
    # Build the discovery inventory (complete list of considered paths + disposition).
    INVENTORY="$(build_inventory)"
    SYNTHESIS="$(build_prioritized_synthesis)"

    # Complete durable reference body: discovery inventory + every source per its
    # tier (archives reference-only). No discovered source is dropped.
    REF_BODY=$'# Agent-Enhance — Synthesis Knowledge Repository\n\n'
    REF_BODY+=$'Preserves, by reference, every discovered source from the synthesis-and-apply run.\n'
    REF_BODY+=$'Nothing here was deleted or silently dropped. This durable home provides full\n'
    REF_BODY+=$'content for knowledge the lean live AGENTS.md intentionally does not inline.\n'
    REF_BODY+=$'\nGenerated by: agent-enhance v'
    REF_BODY+="$VERSION"
    REF_BODY+=$'\nDate: '
    REF_BODY+="$TODAY"
    REF_BODY+=$'\nLanguage: '
    REF_BODY+="${LANG}"
    REF_BODY+=$'\n\n---\n\n'
    REF_BODY+=$'## Complete Discovery Inventory\n\n'
    REF_BODY+=$'Every file below was considered during this synthesis. No discovered source is\n'
    REF_BODY+=$'silently dropped; each has a tier and is either referenced or inlined in this\n'
    REF_BODY+=$'repository. Historical-archive material is referenced (never bulk-inlined).\n\n'
    REF_BODY+="$INVENTORY"
    REF_BODY+=$'\n\n---\n\n'
    REF_BODY+=$'## Prioritized Synthesis (elevated Canon / Skills / Current)\n\n'
    REF_BODY+="$SYNTHESIS"
    REF_BODY+=$'\n---\n\n'
    REF_BODY+=$'## Full Preserved Content (per source & tier)\n\n'
    REF_BODY+="$(build_body)"

    # A short, human/agent-readable note on just the elevated sources.
    ELEVATED=$'# Agent-Enhance — Elevated Synthesis Notes\n\n'
    ELEVATED+=$'Summarises the Canon / Skills / Current material that maps into the live\n'
    ELEVATED+=$'AGENTS.md. Full preserved content, including archives, lives in\n'
    ELEVATED+=$'synthesis-inventory.md.\n\n'
    ELEVATED+="$SYNTHESIS"

    # --- 2. Compose the lean, always-on live AGENTS.md (protocols + elevated synthesis) ---
    LEAN_AGENTS="$(build_live_agents "$COUNT" "$SYNTHESIS")"

    info "Building lean AGENTS.md and durable knowledge repository under $REFS_DIR/"

    # --- 3. Write (dry-run safe) all outputs ---
    write_file "$INVENTORY_FILE" "$REF_BODY"
    write_file "$REFS_DIR/synthesis-elevated.md" "$ELEVATED"
    write_file "AGENTS.md" "$LEAN_AGENTS"

    # --- 4. Decision entry (append; idempotent) ---
    if $DRY_RUN; then
      info "[dry-run] would append decision entry to $MEMORY_DIR/decisions.md"
    elif [[ ! -f "$MEMORY_DIR/decisions.md" ]] || ! grep -qF "Synthesis-and-apply (v$VERSION)" "$MEMORY_DIR/decisions.md"; then
      { printf '\n### %s — Synthesis-and-apply (v%s)\n\n- **Decision**: Upgraded AGENTS.md via agent-enhance --synthesize to a lean, protocol-compliant version.\n' "$TODAY" "$VERSION"
        printf '%s\n' "- **Rationale**: Keep the always-on contract lean while preserving all discovered knowledge under progressive disclosure."
        printf '%s\n' "- **Elevated**: Canon / Skills / Current tiers were surfaced in the live AGENTS.md."
        printf '%s\n' "- **Preserved**: Complete inventory + every source under $REFS_DIR/ (see synthesis-inventory.md)."
        printf '%s\n' "- **Consequences / follow-ups**: Historical-archive and lower-tier content are reference-only; review before editing."
        printf '%s\n' "- **Related files / PRs**: AGENTS.md, .agents/references/synthesis-inventory.md, .agents/references/synthesis-elevated.md"
        printf '%s\n' "- **Recorded by**: agent-enhance v$VERSION"
      } >> "$MEMORY_DIR/decisions.md"
      info "appended decision entry: $MEMORY_DIR/decisions.md"
    else
      info "decision entry already recorded (left untouched): $MEMORY_DIR/decisions.md"
    fi

    # --- 5. Handoff ---
    HANDOFF_CONTENT=$(cat <<HOF
Handoff — synthesis apply — $TODAY
Goal
Review the synthesized live AGENTS.md and the durable knowledge repository produced by agent-enhance --synthesize.
Current State

Completed:
- Live AGENTS.md rewritten to the lean, protocol-compliant version.
- Every discovered source preserved: ".agents/references/synthesis-inventory.md" holds the full inventory and all preserved content.
- Elevated (Canon / Skills / Current) notes in ".agents/references/synthesis-elevated.md".
- Decision recorded in .agents/memory/decisions.md.

In progress:

Human/agent review of the applied changes.

Blocked / open questions:

None known.

Key Decisions Made
- Synthesis-and-apply: AGENTS.md now reflects the elevated material; historical content is preserved by reference.
- No discovered source was deleted.
Files / Areas Touched

AGENTS.md (rewritten lean)
.agents/references/synthesis-inventory.md (new)
.agents/references/synthesis-elevated.md (new)
.agents/memory/decisions.md (appended)

Exact Next Actions for the Receiving Session

1. Read AGENTS.md and the Session Start protocol.
2. Review .agents/references/synthesis-inventory.md for the full preserved set.
3. Confirm nothing important was lost; adjust the lean AGENTS.md if needed.
4. Keep .agents/memory/current-status.md and decisions.md current.

Context the New Agent Must Load

Always: .agents/memory/current-status.md and recent .agents/memory/decisions.md
Relevant skills: (list if any)
Relevant references: .agents/references/synthesis-inventory.md (full preserved content)
Role charter (if multi-agent): (path)

Additional Notes
The repository now advances to the mission-critical structure: a lean always-on AGENTS.md, with full knowledge preserved under progressive disclosure.
HOF
)
    write_file "$HANDOFFS_DIR/$TODAY-synthesis-apply.md" "$HANDOFF_CONTENT"
  fi

  echo
  info "Enhancement complete (synthesize-and-apply mode)."
  if $DRY_RUN; then
    info "This was a dry-run. Re-run without --dry-run to apply the synthesis to the live AGENTS.md."
  else
    info "The live AGENTS.md was rewritten lean; all discovered knowledge is preserved under $REFS_DIR/."
  fi
  exit 0
fi

# ============================================================================
# Default mode: apply the structure and protocols (additive, idempotent)
# ============================================================================

# ----- AGENTS.md -----
AGENTS_FILE="AGENTS.md"
if [[ ! -f "$AGENTS_FILE" ]]; then
  info "No AGENTS.md found — creating a new one"
  CONTENT=$(cat <<'AGENTS'
Agent Instructions
Overview
This repository has been enhanced with AI-agent-native structure and continuity protocols.
Primary stack (detected): LANG_PLACEHOLDER.
Commands
(Add the exact build, test, lint, and type-check commands used by this project.)
Hard Constraints

Never commit secrets, credentials, or files listed in .gitignore.
Prefer existing utilities and patterns already present in the codebase.
All non-trivial architectural or process decisions must be recorded in .agents/memory/decisions.md.
Session continuity relies on the files under .agents/. Do not treat chat history as durable state.

MARKER_BEGIN_PLACEHOLDER
PROTOCOL_PLACEHOLDER
MARKER_END_PLACEHOLDER
PROGRESSIVE_PLACEHOLDER
DOD_PLACEHOLDER
Further Reading

Architecture notes: .agents/references/architecture.md
Conventions: .agents/references/conventions.md
Handoff template: .agents/handoffs/template-handoff.md
AGENTS
)
  CONTENT="${CONTENT//LANG_PLACEHOLDER/$LANG}"
  CONTENT="${CONTENT//MARKER_BEGIN_PLACEHOLDER/$MARKER_BEGIN}"
  CONTENT="${CONTENT//PROTOCOL_PLACEHOLDER/$PROTOCOL_BLOCK}"
  CONTENT="${CONTENT//MARKER_END_PLACEHOLDER/$MARKER_END}"
  CONTENT="${CONTENT//PROGRESSIVE_PLACEHOLDER/$PROGRESSIVE_DISCLOSURE_BLOCK}"
  CONTENT="${CONTENT//DOD_PLACEHOLDER/$DEFINITION_OF_DONE_BLOCK}"
  write_file "$AGENTS_FILE" "$CONTENT"
else
  if grep -qF "$MARKER_BEGIN" "$AGENTS_FILE" 2>/dev/null; then
    info "AGENTS.md already contains agent-enhance markers — leaving protocols untouched"
  else
    info "AGENTS.md exists — injecting mandatory protocols with markers"
    append_if_missing "$AGENTS_FILE" "$PROTOCOL_BLOCK"
  fi
fi

# ----- CLAUDE.md bridge -----
if [[ ! -f "CLAUDE.md" ]]; then
  write_file "CLAUDE.md" "$(cat <<'EOF'
Claude-specific entry point
The canonical, tool-agnostic instructions live in AGENTS.md.
@AGENTS.md
Claude-specific notes

Prefer the project’s established Skills under .agents/skills/ when a matching workflow exists.
Respect the Session Start and Handoff protocols defined in AGENTS.md without exception.
When in doubt about project state, re-read .agents/memory/current-status.md and recent decisions.
EOF
)"
else
  info "exists (left untouched): CLAUDE.md"
fi

echo
info "Enhancement complete."
if $DRY_RUN; then
  info "This was a dry-run. Re-run without --dry-run to apply changes."
else
  info "Review the changes, then commit them."
  info "Recommended commit message:"
  echo "  chore: apply agent-enhance structure and continuity protocols"
fi
echo
info "Next steps for agents and humans:"
echo "  1. Read AGENTS.md (especially the Session Start and Handoff protocols)"
echo "  2. Keep .agents/memory/current-status.md and decisions.md current"
echo "  3. Use .agents/handoffs/ for any incomplete work that spans sessions"